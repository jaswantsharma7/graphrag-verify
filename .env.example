# Copy to .env for local use. Never commit .env.
APP_MODE=demo
# Optional: protects every /api route (send as X-API-Key).
API_KEY=
# Only needed if frontend calls backend directly (no Vercel rewrite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATA_DIR=/var/data

# Live mode only.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
